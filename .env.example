OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=replace-with-model-id
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=LeannaAuto
AUTOMATON_DB=./data/automaton.db
DOCKER_IMAGE=node:22-bookworm-slim
INFERENCE_QUOTA=100000
INFERENCE_QUOTA_USED=0
MAX_CHILDREN_PER_AGENT=3
MAX_AGENTS_TOTAL=20

# Dashboard admin token (required for UI/API access)
LEANNAAUTO_UI_TOKEN=replace-with-a-long-random-secret

# Optional restricted dashboard operator token (read, start/stop agents, create tasks)
LEANNAAUTO_UI_OPERATOR_TOKEN=replace-with-a-different-long-random-secret
